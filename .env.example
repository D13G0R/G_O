# Copia este archivo como .env y completa los valores reales.
# .env está ignorado por git y no debe versionarse.
# PostgreSQL local usado por spring-boot:run.
DB_PASSWORD=cambia-esta-contrasena
# PostgreSQL del contenedor Docker (debe coincidir con el volumen existente).
DOCKER_DB_PASSWORD=cambia-esta-contrasena-docker
# Mínimo 32 bytes. Puede ser texto plano o Base64 aleatorio.
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-64-bytes
# Orígenes permitidos separados por coma. No se admite '*'.
CORS_ALLOWED_ORIGINS=http://localhost:4200
